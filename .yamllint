---
extends: default
# Skip what git ignores, such as the collections that ansible-galaxy installs.
ignore-from-file: .gitignore
rules:
  # Enable every rule as an error, including those off by default, except
  # key-ordering and quoted-strings: keys keep their natural order, and strings
  # are quoted only where YAML needs it.
  comments:
    level: error
  comments-indentation:
    level: error
  document-end: enable
  document-start:
    level: error
  empty-values: enable
  float-values: enable
  line-length:
    # Same limit as ruff (E501).
    max: 160
  octal-values: enable
  truthy:
    level: error
...
